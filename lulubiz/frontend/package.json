{
  "name": "lulubiz-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "dev": "concurrently -k \"npm:css\" \"vite\"",
    "build": "npm run build:css && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
