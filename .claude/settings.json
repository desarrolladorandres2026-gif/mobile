{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/zipp-router.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/zipp-router.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(npm install --prefix \"C:\\\\Users\\\\desar\\\\Videos\\\\ZIPP\\\\backend\")",
      "PowerShell(npm run dev --prefix \"C:\\\\Users\\\\desar\\\\Videos\\\\ZIPP\\\\backend\")",
      "PowerShell(Get-NetTCPConnection -State Listen | Where-Object { $_.LocalPort -in 3000,4000,5000,8000,8080,27017 } | Select-Object LocalAddress, LocalPort, OwningProcess | Format-Table -AutoSize)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:3000/health\" -UseBasicParsing -TimeoutSec 10; \"HEALTH: $\\($r.StatusCode\\) $\\($r.Content\\)\" } catch { \"HEALTH ERROR: $\\($_.Exception.Message\\)\" })"
    ],
    "additionalDirectories": [
      "C:\\Users\\desar\\Videos\\ZIPP\\backend\\node_modules"
    ]
  }
}
