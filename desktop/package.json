{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Zipp Negocios — contenedor de escritorio para Windows del panel de comercios",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "keygen": "node scripts/keygen.mjs",
    "dist": "npm run build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.12.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.2": true
  }
}
