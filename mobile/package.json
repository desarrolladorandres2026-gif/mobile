    "axios": "^1.16.1",
    "expo": "~55.0.0",
    "expo-auth-session": "~55.0.18",
    "expo-battery": "~55.0.17",
    "expo-constants": "~55.0.0",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.7",
