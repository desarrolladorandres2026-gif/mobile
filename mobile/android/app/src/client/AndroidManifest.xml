<!--
  Manifest del flavor de clientes. Se fusiona encima de src/main.

  La ubicación en segundo plano y el servicio en primer plano son cosa de
  los domiciliarios (seguir el pedido con la pantalla apagada). El cliente
  solo necesita ubicación mientras usa la app; declarar más de lo que se
  usa obliga a justificarlo en Play Console y asusta en el instalador.
  Los permisos vienen de src/main (los puso el config plugin de expo-location
  al generar el proyecto); el AAR de la librería solo declara COARSE/FINE.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove"/>
  <application>
    <!-- El servicio de tracking de expo-location queda inerte sin el permiso; se quita para no declarar un foregroundServiceType="location" que nunca se usa. -->
    <service android:name="expo.modules.location.services.LocationTaskService" tools:node="remove"/>
  </application>
</manifest>
