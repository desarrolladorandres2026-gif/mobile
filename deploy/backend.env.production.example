# ─────────────────────────────────────────────────────────────
#  ZIPP · Backend · SOLO lo que cambia para PRODUCCIÓN
# ─────────────────────────────────────────────────────────────
#  Flujo:
#    1. cp backend/.env.example backend/.env
#    2. Sobrescribe en backend/.env al menos las claves de abajo.
#
#  No es un .env completo: el resto de valores (tracking, delivery,
#  order flow, rate limits...) toma los defaults de .env.example y
#  se ajusta luego desde el panel admin, no aquí.
#
#  El servidor SE NIEGA A ARRANCAR en producción si falta o es débil
#  cualquiera de: JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY,
#  CSRF_SECRET, MONGODB_URI  (ver backend/src/config/env.ts).
# ─────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000                         # Nginx hace proxy 443 -> 127.0.0.1:3000

# ── MongoDB Atlas ────────────────────────────────────────────
# Atlas → Database → Connect → Drivers. Añade la IP del VPS en
# Atlas → Network Access ANTES de arrancar, o la conexión cuelga.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/zipp?retryWrites=true&w=majority&appName=zipp

# ── Secretos ─────────────────────────────────────────────────
# Genera CADA UNO por separado (los cuatro distintos entre sí):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotarlos invalida todas las sesiones activas. Guárdalos fuera del
# repo (gestor de contraseñas), nunca en un commit.
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
CSRF_SECRET=

# ── CORS / orígenes de confianza ─────────────────────────────
# Dominios REALES con https://. Sin barra final. Estos tres son la
# allowlist de CORS y de Socket.IO en producción.
#   CLIENT_URL   = PWA móvil (o el dominio del cliente final)
#   ADMIN_URL    = panel interno
#   BUSINESS_URL = portal de comercios
CLIENT_URL=https://app.REEMPLAZAR_DOMINIO
ADMIN_URL=https://panel.REEMPLAZAR_DOMINIO
BUSINESS_URL=https://comercios.REEMPLAZAR_DOMINIO

# ── Cloudinary (imágenes de producto, evidencias, flyers) ────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mapbox (mapas, rutas, ETA, tracking en vivo) ─────────────
# Token PÚBLICO (empieza por "pk."). Un "sk." aquí es fallo de
# arranque. Restríngelo por URL en account.mapbox.com a los
# dominios de arriba. Sin token: la plataforma sigue, sin mapa.
MAPBOX_ACCESS_TOKEN=

# ── Pagos ────────────────────────────────────────────────────
# Arranca en sandbox. Cambia a "wompi" y rellena las 4 claves
# WOMPI_* de .env.example cuando tengas la cuenta aprobada.
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=COP

# ── OTP / mensajería (opcional al inicio) ────────────────────
# Vacío = los códigos salen solo por los logs del servidor. Para
# operar de verdad configura WHATSAPP_PROVIDER y/o EMAIL_PROVIDER
# con sus credenciales (ver .env.example).
WHATSAPP_PROVIDER=
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=

# ── 2FA ──────────────────────────────────────────────────────
# Los admin necesitan TOTP obligatorio en producción. Déjalo así.
TOTP_REQUIRED_ADMINS=true
TOTP_ISSUER=ZIPP
