# ZIPP · Web (sitio público) · Producción
#
# El sitio llama a la API (catálogo, cuenta, pedidos) y abre el socket de
# seguimiento. Cada URL va con https://, sin barra final.
#
#   cp deploy/web.env.production.example web/.env.production
#   cd web && npm ci && npm run build   -> genera web/dist/

# API REST, con el prefijo /api/v1.
VITE_API_URL=https://api.REEMPLAZAR_DOMINIO/api/v1
# Socket.IO vive en el mismo origen que la API, fuera de /api/v1.
VITE_SOCKET_URL=https://api.REEMPLAZAR_DOMINIO
# Portal de comercios.
VITE_BUSINESS_URL=https://comercios.REEMPLAZAR_DOMINIO
# Client ID web de Google (Google Identity Services). Vacío = sin botón de Google.
VITE_GOOGLE_CLIENT_ID=
