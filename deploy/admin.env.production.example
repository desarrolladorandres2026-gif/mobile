# ZIPP · Admin · Producción
#
# Vite congela estos valores EN EL BUILD (import.meta.env). Cambiarlos
# después obliga a recompilar y re-subir dist/. No son secretos: viajan
# en el bundle que sirve el navegador.
#
#   cp deploy/admin.env.production.example admin/.env.production
#   (edita el dominio real)
#   cd admin && npm ci && npm run build   -> genera admin/dist/

VITE_API_URL=https://api.REEMPLAZAR_DOMINIO/api/v1
VITE_SOCKET_URL=https://api.REEMPLAZAR_DOMINIO
