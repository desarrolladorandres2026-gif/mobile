# ─────────────────────────────────────────
#  ZIPP Backend – Variables de Entorno
#  Copia como .env y completa los valores.
# ─────────────────────────────────────────
#
#  En producción el servidor SE NIEGA A INICIAR si falta o es débil
#  cualquiera de: JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY,
#  CSRF_SECRET, MONGODB_URI. Es intencional: un secreto predecible
#  permite firmar tokens válidos para cualquier cuenta.
#
#  En desarrollo, los secretos ausentes se generan al azar en cada
#  arranque (las sesiones se invalidan al reiniciar).

# ── Servidor ──────────────────────────────
PORT=3000
NODE_ENV=development            # development | production | test

# ── MongoDB ───────────────────────────────
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/zipp
# Local: mongodb://localhost:27017/zipp
MONGODB_URI=mongodb://localhost:27017/zipp

# ── JWT ───────────────────────────────────
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET y JWT_REFRESH_SECRET deben ser DIFERENTES entre sí.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cifrado ───────────────────────────────
ENCRYPTION_KEY=

# ── CSRF ──────────────────────────────────
CSRF_SECRET=

# ── Cloudinary (imágenes) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Maps (geocoding / rutas) ───────
# Opcional. Sin clave, el cálculo de distancia usa la fórmula de
# Haversine sobre las coordenadas guardadas (funciona sin conexión).
GOOGLE_MAPS_API_KEY=

# ── Mapbox (mapas, rutas y seguimiento en vivo) ───
# Token PÚBLICO de https://account.mapbox.com/access-tokens/ — empieza por
# "pk.". El servidor lo entrega a los clientes ya autenticados en
# GET /tracking/config, porque para dibujar un mapa el token tiene que
# viajar al dispositivo. Se protege restringiéndolo por URL en el panel de
# Mapbox, no ocultándolo.
#
# NUNCA pongas aquí un token secreto ("sk."): da acceso a la cuenta entera
# y el servidor lo repartiría a cada teléfono. En producción el arranque
# falla si detecta uno.
#
# Sin token, la plataforma sigue funcionando: no hay mapa ni ruta, el ETA
# se estima con distancia en línea recta y el seguimiento por socket sigue
# igual. Es una degradación, no una caída.
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_PROFILE=driving      # driving | cycling | walking
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
MAPBOX_STYLE_URL_DARK=mapbox://styles/mapbox/dark-v11
MAPBOX_ROUTE_CACHE_TTL_MS=300000       # 5 min: una ruta urbana no cambia en minutos
MAPBOX_GEOCODE_CACHE_TTL_MS=86400000   # 1 día: el nombre de una calle no cambia
MAPBOX_TIMEOUT_MS=4000                 # si Mapbox tarda más, se entrega sin ruta

# ── Reparto automático de pedidos ─────────
# La cascada ofrece el pedido al domiciliario más cercano (45 s), luego a
# los tres mejores (30 s) y por último a todos (20 s). Mientras está
# ofrecido, nadie más puede tomarlo.
#
# La app del domiciliario ya sabe recibirla por los dos caminos: el socket
# (`order:offer`) cuando está abierta, y una push de alta prioridad con la
# oferta entera cuando está cerrada — que es el caso normal, porque quien
# conduce lleva el teléfono bloqueado. Ver `notifyOffer` en
# `services/dispatch.service.ts` y el canal 'offers' en `mobile/lib/push.ts`.
#
# Se puede apagar en caliente desde el panel sin redesplegar: el interruptor
# `dispatch.cascade` de FeatureFlag. Esta variable es el suelo, no el techo.
DISPATCH_ENABLED=true

# ── Seguimiento GPS de repartidores ───────
# Umbrales del SERVIDOR (cuánto se escribe y se retransmite). Cada cuánto
# el teléfono pide un fix al GPS se decide en la app: es otro problema
# —batería— y por eso es otro número.
TRACKING_MIN_PERSIST_MS=5000           # mínimo entre dos escrituras por repartidor
TRACKING_MIN_MOVE_METERS=15            # menos movimiento que esto, ping descartado
TRACKING_MAX_ACCURACY_METERS=100       # un fix peor que esto miente más de lo que informa
TRACKING_HISTORY_DAYS=30               # retención del rastro, para auditar entregas
TRACKING_STALE_AFTER_MS=90000          # sin señal por más de esto = "perdido"
TRACKING_NEAREST_RADIUS_METERS=8000    # radio de búsqueda del repartidor más cercano

# ── Google OAuth (inicio de sesión con Google) ─
# Crea un proyecto en https://console.cloud.google.com/apis/credentials y
# genera un Client ID de tipo "Web application" y otro "iOS"/"Android" según
# lo que uses. El flujo móvil usa Authorization Code + PKCE por navegador,
# así que basta con el Web Client ID en la mayoría de los casos.
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=

# ── Pagos ─────────────────────────────────
# sandbox = proveedor local completamente funcional, sin credenciales.
# wompi   = Wompi Colombia (Web Checkout: PSE, Nequi, tarjetas, Bancolombia
#           Transfer — todo lo habilitado en tu cuenta de Wompi, sin que
#           ZIPP maneje tarjetas ni credenciales bancarias).
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=COP
# Usado solo por el proveedor sandbox para firmar sus webhooks de prueba.
PAYMENT_WEBHOOK_SECRET=

# Comportamiento del sandbox (ignorado por proveedores reales)
SANDBOX_AUTO_APPROVE=true
SANDBOX_FAIL_SUFFIX=13          # importes cuyos centavos terminan así fallan

# ── Wompi Colombia (PAYMENT_PROVIDER=wompi) ────────
# Todas se obtienen en el Dashboard de Wompi → Configuración de mi cuenta →
# "Secretos para integración técnica" (https://comercios.wompi.co).
# Wompi entrega un par sandbox (prefijo *_test_) y uno de producción
# (prefijo *_prod_): el proveedor detecta cuál usar por el prefijo de
# WOMPI_PUBLIC_KEY, así que pasar a producción es solo cambiar estas 4
# variables — no hay que tocar código ni ninguna otra bandera.
#
# WOMPI_PUBLIC_KEY y WOMPI_PRIVATE_KEY: llaves pública y privada.
#   ¡NUNCA envíes WOMPI_PRIVATE_KEY al frontend/app móvil!
# WOMPI_INTEGRITY_SECRET: firma los enlaces de Web Checkout (evita que se
#   altere el monto/referencia entre el servidor y la página de Wompi).
# WOMPI_EVENTS_SECRET: verifica la firma de los webhooks entrantes.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Minutos que un enlace de Web Checkout sigue siendo pagable. Sin límite, un
# enlace recuperado de un log o una captura de pantalla sigue siendo un cobro
# vivo meses después, para un pedido quizá ya cancelado o re-tarifado.
WOMPI_CHECKOUT_EXPIRY_MINUTES=30

# Esquema de deep link de la app. Es la única URL de retorno que el backend
# acepta para el `redirect-url` del checkout (además de los orígenes CORS
# configurados arriba). Sin esta lista blanca, el cliente podría hacer que
# Wompi redirija a cualquier sitio desde su propio dominio — un open redirect
# con la credibilidad de checkout.wompi.co detrás.
APP_DEEP_LINK_SCHEME=zipp

# ── WhatsApp Business (OTP de teléfono) ───
# Opciones: meta_cloud_api | twilio_whatsapp | (vacío = solo consola en dev)
WHATSAPP_PROVIDER=

# Meta Cloud API (si WHATSAPP_PROVIDER=meta_cloud_api)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Twilio WhatsApp (si WHATSAPP_PROVIDER=twilio_whatsapp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM_NUMBER=

# ── Email (OTP de correo) ─────────────────
# Opciones: sendgrid | smtp | (vacío = solo consola en dev)
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=

# SendGrid (si EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# SMTP (si EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── OTP ───────────────────────────────────
OTP_EXPIRY_MINUTES=5

# ── Plataforma ────────────────────────────
PLATFORM_COMMISSION_RATE=0.10       # 10%
DEFAULT_DELIVERY_FEE=5000           # respaldo si no hay zona ni coordenadas
DEFAULT_DRIVER_BASE_FUND=50000      # $50.000 COP
PLATFORM_TAX_RATE=0                 # 0 = precios ya incluyen IVA
MAX_TIP_RATE=1                      # propina máxima como múltiplo del subtotal

# ── Tarifa de domicilio por distancia ─────
# fee = base + (km facturables × perKm), acotado a [min, max]
DELIVERY_BASE_FEE=4000
DELIVERY_PER_KM=900
DELIVERY_FREE_RADIUS_KM=1           # km incluidos en la tarifa base
DELIVERY_MIN_FEE=3000
DELIVERY_MAX_FEE=20000
DELIVERY_ROUNDING=100               # redondeo al múltiplo más cercano
DELIVERY_MAX_RADIUS_KM=12           # fuera de esto no hay cobertura

# ── CORS ──────────────────────────────────
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
BUSINESS_URL=http://localhost:3002

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000         # 15 minutos
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Sesiones ──────────────────────────────
MAX_ACTIVE_SESSIONS=5
SESSION_TTL_DAYS=7

# ── Brute Force ───────────────────────────
BF_MAX_USER_ATTEMPTS=5
BF_MAX_IP_ATTEMPTS=20
BF_LOCK_DURATION_MIN=15

# ── 2FA ───────────────────────────────────
TOTP_REQUIRED_ADMINS=true
TOTP_ISSUER=ZIPP

# ── Monetización (v2) ─────────────────────────
# Estos valores solo siembran la VERSIÓN 1 de PlatformPricingConfig la
# primera vez que arranca. A partir de ahí la configuración vive en la base
# de datos y se edita en el panel admin → Precios y monetización, con
# versionado y auditoría. Cambiar el .env ya no cambia los precios.
#
# El fee de servicio y el margen de domicilio arrancan en 0 a propósito:
# la migración no debe subir precios por su cuenta.
#
# PAGO CONTRA ENTREGA arranca DESACTIVADO. Actívalo solo cuando la
# conciliación de efectivo esté operando (panel admin → Finanzas).

# -- Traspaso del pedido -----------------------
# Los dos codigos de un solo uso (recogida y entrega) y la evidencia
# fotografica. Ver README, "El traspaso del pedido".
#
# Subir ORDER_CODE_MAX_ATTEMPTS por encima de 5 hace el codigo adivinable
# por fuerza bruta: con 6 digitos y bloqueo de 15 minutos, 5 intentos son
# una probabilidad de acierto de 1 entre 200.000 por ventana.
ORDER_CODE_LENGTH=6
ORDER_CODE_MAX_ATTEMPTS=5
ORDER_CODE_LOCK_MINUTES=15
ORDER_CODE_TTL_HOURS=24              # 0 = sin caducidad

ORDER_EVIDENCE_MAX_BYTES=5242880     # 5 MB
ORDER_EVIDENCE_URL_TTL_MIN=10        # vida de la URL firmada
ORDER_EVIDENCE_FOLDER=zipp/order-evidence

ORDER_CHAT_MAX_LENGTH=1000
ORDER_CHAT_MAX_PER_WINDOW=30
ORDER_CHAT_WINDOW_MS=60000

ORDER_CALL_MAX_MINUTES=15
ORDER_CALL_RING_SECONDS=45

# -- Liquidaciones -----------------------------
# La zona horaria no es cosmetica: agrupar las semanas en UTC mueve la
# frontera cinco horas, y los pedidos del domingo por la noche caerian en
# la liquidacion de la semana siguiente.
SETTLEMENT_TIMEZONE=America/Bogota
SETTLEMENT_START_OF_WEEK=monday
SETTLEMENT_HISTORY_WEEKS=8

# -- Imagenes del catalogo ---------------------
# Las fotos de producto se guardan en Cloudinary (mismas credenciales de
# arriba) como un unico master cuadrado de 1200 px. Las cuatro variantes
# -miniatura, catalogo, ficha y grande- se generan en la URL de entrega,
# igual que la mejora automatica: el archivo guardado nunca se retoca.
#
# El minimo de 500 px no es arbitrario: la variante de ficha se sirve a
# 800, asi que por debajo el catalogo estaria ampliando pixeles.
PRODUCT_IMAGE_FOLDER=zipp/products
PRODUCT_IMAGE_MAX_BYTES=8388608      # 8 MB
PRODUCT_IMAGE_MIN_DIMENSION=500

# Recorte de fondo con IA. Es un COMPLEMENTO DE PAGO de Cloudinary que la
# mayoria de las cuentas no tiene. Con esto en false el panel ni siquiera
# ensena el boton: un boton que falla siempre es peor que no tenerlo.
CLOUDINARY_BACKGROUND_REMOVAL=false

# -- Flyers de publicidad patrocinada ----------
# Mismas credenciales de Cloudinary de arriba, carpeta aparte. El minimo es
# mas bajo que el de producto porque un flyer se ve a pantalla completa con
# "contain" (nunca recortado), no dentro de una rejilla fija.
AD_FLYER_FOLDER=zipp/advertisements
AD_FLYER_MAX_BYTES=5242880           # 5 MB
AD_FLYER_MIN_DIMENSION=480
