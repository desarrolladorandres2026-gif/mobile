# ZIPP — Sitio público
# URL del portal de comercios al que enlaza el botón "Portal de comercios".
VITE_BUSINESS_URL=http://localhost:3002
# URL base de la API (catálogo, cuenta, pedidos, documentos legales).
VITE_API_URL=http://localhost:3000/api/v1
# Origen del socket de seguimiento (mismo origen que la API, sin /api/v1).
VITE_SOCKET_URL=http://localhost:3000
# Client ID web de Google. Vacío = sin botón de Google.
VITE_GOOGLE_CLIENT_ID=
